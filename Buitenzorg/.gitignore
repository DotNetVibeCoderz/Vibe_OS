# Rust
kernel/target/
userland/clrhost/target/
**/*.rs.bk

# .NET
**/bin/
**/obj/
*.user

# Build output (the images; userland/clr-apps/dist holds the committed
# managed-app assemblies -- see scripts/build-clr-apps.*)
/dist/
*.img
*.qcow2
*.vhdx
*.vmdk
*.vdi

# Userland build artifacts (hello.elf is rebuilt by scripts/build-hello-csharp)
userland/**/*.o
userland/**/*.elf

# Third-party toolchains fetched locally (bflat is ~90 MB)
# (use tools/* not tools/ — git cannot re-include inside an excluded directory)
tools/*
# ...but MagicAppGen is our own source (sans build output).
!tools/MagicAppGen/
tools/MagicAppGen/bin/
tools/MagicAppGen/obj/
# ZerolibPatch (adds the arm64 runtime helpers zerolib lacks) is ours too.
!tools/ZerolibPatch/
tools/ZerolibPatch/bin/
tools/ZerolibPatch/obj/

# Editors / OS
.vs/
.idea/
*.swp
Thumbs.db
.DS_Store

# Local secrets — API keys for LLM/testing. NEVER commit.
testkey.txt

# Generation log written by the Rodin MCP image tools
*_History.json
