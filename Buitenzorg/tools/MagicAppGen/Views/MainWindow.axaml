<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="using:AvaloniaEdit"
        x:Class="MagicAppGen.Views.MainWindow"
        Width="1360" Height="820" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Title="Magic App Generator"
        Background="{StaticResource Canopy}">

  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ================= Top bar ================= -->
    <Border Grid.Row="0" Background="{StaticResource Canopy}" BorderBrush="{StaticResource Vein}" BorderThickness="0,0,0,1"
            Padding="10,6">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">
        <!-- Brand mark -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="2,0,10,0">
          <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource LeafFill}">
            <Path Data="{StaticResource IconLeaf}" Fill="#0B1611" Width="14" Height="14" Stretch="Uniform" />
          </Border>
          <TextBlock Text="Magic App Generator" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
        </StackPanel>

        <Menu Grid.Column="1" VerticalAlignment="Center">
          <MenuItem Header="_Berkas">
            <MenuItem Header="Proyek baru dari templat…" Click="OnNewTemplate" InputGesture="Ctrl+Shift+N" />
            <MenuItem Header="Proyek kosong…" Click="OnNewBlank" />
            <Separator />
            <MenuItem Header="Buka folder proyek…" Click="OnOpenProject" InputGesture="Ctrl+Shift+O" />
            <MenuItem Header="Buka berkas…" Click="OnOpenFile" InputGesture="Ctrl+O" />
            <MenuItem Header="Simpan" Click="OnSave" InputGesture="Ctrl+S" />
            <MenuItem Header="Tutup proyek" Click="OnCloseProject" />
            <Separator />
            <MenuItem Header="Keluar" Click="OnExit" />
          </MenuItem>
          <MenuItem Header="_Edit">
            <MenuItem Header="Ke baris…" Click="OnGoToLine" InputGesture="Ctrl+G" />
          </MenuItem>
          <MenuItem Header="_Bangun">
            <MenuItem Header="Bangun" Click="OnBuild" InputGesture="Ctrl+B" />
            <MenuItem Header="Uji mandiri di PC (managed)" Click="OnSelfTest" />
            <MenuItem Header="Kirim ke perangkat" Click="OnDeploy" />
            <MenuItem Header="Bangun &amp; jalankan di perangkat" Click="OnBuildDeployRun" InputGesture="F5" />
            <MenuItem Header="Hentikan aplikasi" Click="OnStop" InputGesture="Shift+F5" />
            <Separator />
            <MenuItem Header="Bangun image OS (scripts/build.ps1)" Click="OnBuildImage" />
          </MenuItem>
          <MenuItem Header="_Tampilan">
            <MenuItem Header="Panel proyek / perangkat" Click="OnToggleSide" />
            <MenuItem Header="Panel Jack" Click="OnToggleChat" />
            <MenuItem Header="Panel keluaran" Click="OnToggleLogs" />
            <MenuItem Header="Nomor baris" Click="OnToggleLineNumbers" />
          </MenuItem>
          <MenuItem Header="_Alat">
            <MenuItem Header="Pengaturan…" Click="OnSettings" InputGesture="Ctrl+OemComma" />
          </MenuItem>
        </Menu>

        <!-- Project title -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0">
          <TextBlock x:Name="ProjectTitle" Text="Belum ada proyek" Classes="muted" FontSize="12.5" VerticalAlignment="Center" />
          <Border x:Name="ProjectKindChip" Classes="chip" IsVisible="False">
            <TextBlock x:Name="ProjectKindText" />
          </Border>
          <TextBlock x:Name="ProjectTarget" Classes="code faint" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Device pill: where the next Run goes -->
        <Button Grid.Column="3" Classes="ghost" Click="OnShowDevice" Margin="0,0,6,0"
                ToolTip.Tip="Perangkat tujuan: klik untuk membuka panel perangkat">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Ellipse x:Name="DeviceDot" Width="8" Height="8" Fill="{StaticResource MossText}" VerticalAlignment="Center" />
            <TextBlock x:Name="DevicePillText" Text="QEMU lokal" FontSize="12.5" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Grid.Column="4" x:Name="RunTopButton" Classes="primary" Click="OnBuildDeployRun"
                ToolTip.Tip="Bangun, kirim ke perangkat, lalu jalankan (F5)">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <Path Classes="icon solid" Data="{StaticResource IconPlay}" Width="11" Height="11" />
            <TextBlock Text="Jalankan di perangkat" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <!-- ================= Body ================= -->
    <Grid Grid.Row="1" x:Name="BodyGrid" ColumnDefinitions="52,272,1,*,1,384">

      <!-- Rail -->
      <Border Grid.Column="0" Background="{StaticResource Canopy}" BorderBrush="{StaticResource Vein}" BorderThickness="0,0,1,0">
        <DockPanel Margin="0,8">
          <ToggleButton DockPanel.Dock="Bottom" x:Name="RailSettings" Classes="rail" Click="OnSettings" HorizontalAlignment="Center"
                        ToolTip.Tip="Pengaturan" IsChecked="False">
            <Path Classes="icon" Data="{StaticResource IconSettings}" />
          </ToggleButton>
          <StackPanel HorizontalAlignment="Center">
            <ToggleButton x:Name="RailFiles" Classes="rail" IsChecked="True" Click="OnRailFiles" ToolTip.Tip="Proyek">
              <Path Classes="icon" Data="{StaticResource IconFiles}" />
            </ToggleButton>
            <ToggleButton x:Name="RailDevice" Classes="rail" Click="OnRailDevice" ToolTip.Tip="Perangkat: kirim, jalankan, konsol">
              <Path Classes="icon" Data="{StaticResource IconDevice}" />
            </ToggleButton>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- Side panel -->
      <Border Grid.Column="1" x:Name="SidePanel" Background="{StaticResource Understory}">
        <Panel>
          <!-- ===== Explorer ===== -->
          <DockPanel x:Name="ExplorerPanel">
            <Border DockPanel.Dock="Top" Classes="panelhead">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="PROYEK" Classes="eyebrow" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0">
                    <Button Classes="ghost" Click="OnNewTemplate" ToolTip.Tip="Proyek baru dari templat" Padding="6,4">
                      <Path Classes="icon" Data="{StaticResource IconPlus}" Width="14" Height="14" />
                    </Button>
                    <Button Classes="ghost" Click="OnOpenProject" ToolTip.Tip="Buka folder proyek" Padding="6,4">
                      <Path Classes="icon" Data="{StaticResource IconOpen}" Width="14" Height="14" />
                    </Button>
                    <Button Classes="ghost" Click="OnRefreshTree" ToolTip.Tip="Muat ulang daftar berkas" Padding="6,4">
                      <Path Classes="icon" Data="{StaticResource IconRefresh}" Width="14" Height="14" />
                    </Button>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="ExplorerName" Classes="title" TextTrimming="CharacterEllipsis" IsVisible="False" />
                <TextBlock x:Name="ExplorerPath" Classes="faint code" FontSize="10.5" TextTrimming="CharacterEllipsis" IsVisible="False" />
              </StackPanel>
            </Border>

            <!-- Empty state -->
            <StackPanel x:Name="ExplorerEmpty" DockPanel.Dock="Top" Margin="16,20" Spacing="12">
              <TextBlock Text="Belum ada proyek terbuka." Classes="title" />
              <TextBlock Classes="muted" TextWrapping="Wrap"
                         Text="Mulai dari templat — aplikasi jendela C# managed, program native, atau skrip Python/JS/TS — atau minta Jack menulisnya." />
              <Button Classes="primary" Click="OnNewTemplate" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Path Classes="icon" Data="{StaticResource IconPlus}" Width="13" Height="13" />
                  <TextBlock Text="Proyek baru" />
                </StackPanel>
              </Button>
              <Button Click="OnOpenProject" HorizontalAlignment="Left" Content="Buka folder…" />
            </StackPanel>

            <TreeView x:Name="FileTree" Margin="6,6" SelectionChanged="OnTreeSelection" />
          </DockPanel>

          <!-- ===== Device / deploy ===== -->
          <ScrollViewer x:Name="DevicePanel" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="14,12" Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="PERANGKAT" Classes="eyebrow" VerticalAlignment="Center" />
                <Button Grid.Column="1" Classes="ghost" Content="Kelola…" Click="OnManageDevices" Padding="6,3" FontSize="12" />
              </Grid>
              <ComboBox x:Name="DeviceBox" HorizontalAlignment="Stretch" SelectionChanged="OnDeviceChanged" />

              <!-- Signature: the specimen tag -->
              <Border Background="{StaticResource Paper}" CornerRadius="3" Padding="14,12,14,10" BoxShadow="0 6 18 0 #66000000">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                  <Ellipse Grid.Row="0" Width="9" Height="9" Fill="{StaticResource Understory}" HorizontalAlignment="Right"
                           VerticalAlignment="Top" Margin="0,-2,-4,0" />
                  <TextBlock Grid.Row="0" Text="HERBARIUM BUITENZORG" FontSize="9" LetterSpacing="1.6" FontWeight="SemiBold"
                             Foreground="#7A7258" />
                  <TextBlock Grid.Row="1" x:Name="TagSpecies" Classes="label" Text="Buitenzorg OS" FontSize="19"
                             Foreground="{StaticResource PaperInk}" Margin="0,4,0,2" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Row="2" x:Name="TagSubtitle" Classes="label" Text="belum disapa" FontSize="12"
                             Foreground="#6E6650" Margin="0,0,0,8" TextTrimming="CharacterEllipsis" />
                  <Border Grid.Row="3" BorderBrush="{StaticResource PaperRule}" BorderThickness="0,1,0,0" Padding="0,5">
                    <Grid ColumnDefinitions="58,*">
                      <TextBlock Text="ALAMAT" FontSize="9" LetterSpacing="1.2" Foreground="#7A7258" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" x:Name="TagHost" Classes="code" Foreground="{StaticResource PaperInk}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                  </Border>
                  <Border Grid.Row="4" BorderBrush="{StaticResource PaperRule}" BorderThickness="0,1,0,0" Padding="0,5">
                    <Grid ColumnDefinitions="58,*">
                      <TextBlock Text="KODE" FontSize="9" LetterSpacing="1.2" Foreground="#7A7258" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" x:Name="TagCode" Classes="code" Foreground="{StaticResource PaperInk}" />
                    </Grid>
                  </Border>
                  <Border Grid.Row="5" BorderBrush="{StaticResource PaperRule}" BorderThickness="0,1,0,1" Padding="0,5">
                    <Grid ColumnDefinitions="58,*">
                      <TextBlock Text="BLOK DATA" FontSize="9" LetterSpacing="1.2" Foreground="#7A7258" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1" x:Name="TagChunk" Classes="code" Text="—" Foreground="{StaticResource PaperInk}" />
                    </Grid>
                  </Border>
                  <Grid Grid.Row="6" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                    <TextBlock x:Name="TagState" Text="BZDP v1 · UDP" FontSize="10.5" Foreground="#7A7258" VerticalAlignment="Center" />
                    <Button Grid.Column="1" x:Name="HelloButton" Content="Sapa" Click="OnHello" Padding="10,3" FontSize="12"
                            Background="#2B2A22" Foreground="{StaticResource Paper}" BorderBrush="#2B2A22"
                            ToolTip.Tip="Kirim HELLO: cek bahwa perangkat menjawab" />
                  </Grid>
                </Grid>
              </Border>

              <!-- The vine: the real sequence build -> deploy -> run -->
              <Border Classes="card" Padding="12,10">
                <Grid ColumnDefinitions="22,*" RowDefinitions="Auto,Auto,Auto">
                  <Rectangle Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" Width="2" Fill="{StaticResource Vein}"
                             HorizontalAlignment="Center" Margin="0,12" />
                  <Ellipse Grid.Column="0" Grid.Row="0" x:Name="Step1Dot" Width="12" Height="12" Fill="{StaticResource Vein}" VerticalAlignment="Top" Margin="0,4,0,0" />
                  <StackPanel Grid.Column="1" Grid.Row="0" Margin="6,0,0,10">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="Bangun" FontWeight="SemiBold" FontSize="12.5" />
                      <TextBlock Text="semai" Classes="label faint" FontSize="11.5" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock x:Name="Step1Text" Classes="faint" Text="belum dibangun" TextWrapping="Wrap" />
                  </StackPanel>
                  <Ellipse Grid.Column="0" Grid.Row="1" x:Name="Step2Dot" Width="12" Height="12" Fill="{StaticResource Vein}" VerticalAlignment="Top" Margin="0,4,0,0" />
                  <StackPanel Grid.Column="1" Grid.Row="1" Margin="6,0,0,10">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="Kirim" FontWeight="SemiBold" FontSize="12.5" />
                      <TextBlock Text="tanam" Classes="label faint" FontSize="11.5" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock x:Name="Step2Text" Classes="faint" Text="ke /disk perangkat" TextWrapping="Wrap" />
                    <ProgressBar x:Name="UploadProgress" Minimum="0" Maximum="1" Margin="0,5,0,0" IsVisible="False" />
                  </StackPanel>
                  <Ellipse Grid.Column="0" Grid.Row="2" x:Name="Step3Dot" Width="12" Height="12" Fill="{StaticResource Vein}" VerticalAlignment="Top" Margin="0,4,0,0" />
                  <StackPanel Grid.Column="1" Grid.Row="2" Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock Text="Jalankan" FontWeight="SemiBold" FontSize="12.5" />
                      <TextBlock Text="tumbuh" Classes="label faint" FontSize="11.5" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock x:Name="Step3Text" Classes="faint code" Text="—" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </Border>

              <TextBox x:Name="ArgsBox" Watermark="Argumen aplikasi (opsional)" Classes="code" />
              <CheckBox x:Name="LibsCheck" Content="Kirim juga BZAPP.DLL &amp; BZUI.DLL" Click="OnLibsChanged"
                        ToolTip.Tip="Untuk aplikasi managed, bila pustaka di image perangkat lebih lama dari milik Anda" />

              <Button x:Name="FlowButton" Classes="primary" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                      Click="OnBuildDeployRun">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Path Classes="icon solid" Data="{StaticResource IconPlay}" Width="11" Height="11" />
                  <TextBlock Text="Bangun, kirim &amp; jalankan" />
                </StackPanel>
              </Button>
              <Grid ColumnDefinitions="*,6,*,6,*">
                <Button Grid.Column="0" Click="OnBuild" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Bangun ke folder out/ (Ctrl+B)">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Path Classes="icon" Data="{StaticResource IconBuild}" Width="13" Height="13" />
                    <TextBlock Text="Bangun" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="2" Click="OnDeploy" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Bangun lalu kirim ke /disk">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Path Classes="icon" Data="{StaticResource IconUpload}" Width="13" Height="13" />
                    <TextBlock Text="Kirim" />
                  </StackPanel>
                </Button>
                <Button Grid.Column="4" x:Name="StopButton" Classes="danger" Click="OnStop" IsEnabled="False"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" ToolTip.Tip="Hentikan aplikasi yang berjalan (Shift+F5)">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <Path Classes="icon solid" Data="{StaticResource IconStop}" Width="10" Height="10" />
                    <TextBlock Text="Henti" />
                  </StackPanel>
                </Button>
              </Grid>

              <Border x:Name="DeviceErrorCard" Background="{StaticResource HibiscusWash}" BorderBrush="{StaticResource Hibiscus}"
                      BorderThickness="1" CornerRadius="8" Padding="10,8" IsVisible="False">
                <TextBlock x:Name="DeviceErrorText" Classes="error" />
              </Border>

              <Button Classes="ghost" Content="Lihat isi /disk perangkat" Click="OnListDisk" HorizontalAlignment="Left" Padding="4,3" FontSize="12" />
              <TextBlock Classes="faint" TextWrapping="Wrap" FontSize="11"
                         Text="Di perangkat: jalankan `deploy on` di terminal Buitenzorg. Untuk QEMU, teruskan port: -netdev user,id=n0,hostfwd=udp::7070-:7070." />
            </StackPanel>
          </ScrollViewer>
        </Panel>
      </Border>
      <GridSplitter Grid.Column="2" x:Name="SideSplitter" ResizeDirection="Columns" />

      <!-- ===== Editor over the output panel ===== -->
      <Grid Grid.Column="3" x:Name="CenterGrid" RowDefinitions="Auto,*,1,200">
        <Border Grid.Row="0" Background="{StaticResource Understory}" BorderBrush="{StaticResource Vein}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Grid.Column="0" BorderBrush="{StaticResource Leaf}" BorderThickness="0,0,0,2" Padding="14,9" Background="{StaticResource Canopy}">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <Path Classes="icon" Data="{StaticResource IconFile}" Width="13" Height="13" Stroke="{StaticResource Lichen}" />
                <TextBlock x:Name="FileTabText" Text="tanpa judul" FontSize="12.5" VerticalAlignment="Center" />
                <Ellipse x:Name="DirtyDot" Width="7" Height="7" Fill="{StaticResource Pollen}" VerticalAlignment="Center" IsVisible="False"
                         ToolTip.Tip="Belum disimpan" />
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" Margin="0,0,8,0" VerticalAlignment="Center">
              <Button Classes="ghost" Click="OnSave" ToolTip.Tip="Simpan (Ctrl+S)" Padding="7,4">
                <Path Classes="icon" Data="{StaticResource IconSave}" Width="14" Height="14" />
              </Button>
              <Button Classes="ghost" Click="OnBuild" ToolTip.Tip="Bangun (Ctrl+B)" Padding="7,4">
                <Path Classes="icon" Data="{StaticResource IconBuild}" Width="14" Height="14" />
              </Button>
            </StackPanel>
          </Grid>
        </Border>

        <ae:TextEditor x:Name="Editor" Grid.Row="1"
                       ShowLineNumbers="True"
                       FontFamily="{StaticResource CodeFont}"
                       FontSize="13.5" Padding="6,4,0,0"
                       Background="{StaticResource Canopy}" Foreground="{StaticResource Mist}"
                       LineNumbersForeground="#4C6A5B" />

        <GridSplitter Grid.Row="2" ResizeDirection="Rows" />

        <TabControl Grid.Row="3" x:Name="BottomTabs" Background="{StaticResource Understory}" Padding="0">
          <TabItem Header="Keluaran">
            <TextBox x:Name="LogBox" Classes="bare code" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="NoWrap" FontSize="12" Foreground="{StaticResource Lichen}"
                     VerticalContentAlignment="Top" Padding="14,6" />
          </TabItem>
          <TabItem x:Name="DeviceLogTab" Header="Konsol perangkat">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" Margin="0,4,10,0" Spacing="4">
                <CheckBox x:Name="FollowLog" Content="Ikuti" IsChecked="True" ToolTip.Tip="Ambil keluaran perangkat terus-menerus" />
                <Button Classes="ghost" Content="Bersihkan" Click="OnClearDeviceLog" Padding="6,3" FontSize="12" />
              </StackPanel>
              <TextBox x:Name="DeviceLogBox" Classes="bare code" IsReadOnly="True" AcceptsReturn="True"
                       TextWrapping="NoWrap" FontSize="12" Foreground="{StaticResource Mist}"
                       VerticalContentAlignment="Top" Padding="14,6"
                       Watermark="Keluaran aplikasi di perangkat muncul di sini setelah Jalankan." />
            </DockPanel>
          </TabItem>
        </TabControl>
      </Grid>

      <GridSplitter Grid.Column="4" x:Name="ChatSplitter" ResizeDirection="Columns" />

      <!-- ===== Jack ===== -->
      <Grid Grid.Column="5" x:Name="ChatPanel" Background="{StaticResource Understory}" RowDefinitions="Auto,Auto,*,Auto">
        <Border Grid.Row="0" Background="{StaticResource JackGlow}" Padding="16,14,12,12">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Border Width="40" Height="40" CornerRadius="20" Background="{StaticResource LeafFill}" VerticalAlignment="Center">
              <Path Data="{StaticResource IconLeaf}" Fill="#0B1611" Width="20" Height="20" Stretch="Uniform" />
            </Border>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="Jack" Classes="label" FontSize="24" Foreground="{StaticResource Mist}" Margin="0,-4,0,-2" />
              <TextBlock Text="THE CODE BENDER" Classes="eyebrow" Foreground="{StaticResource Leaf}" />
            </StackPanel>
            <Button Grid.Column="2" Classes="ghost" Content="Percakapan baru" Click="OnClearChat" FontSize="12"
                    VerticalAlignment="Center" ToolTip.Tip="Mulai percakapan baru" />
          </Grid>
        </Border>

        <Border Grid.Row="1" Padding="12,8" BorderBrush="{StaticResource Vein}" BorderThickness="0,1,0,1">
          <Grid ColumnDefinitions="Auto,*">
            <ComboBox x:Name="ProviderBox" Width="150" SelectionChanged="OnProviderChanged" />
            <TextBlock Grid.Column="1" x:Name="ModelText" Classes="code faint" VerticalAlignment="Center" Margin="10,0,0,0"
                       TextTrimming="CharacterEllipsis" />
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" x:Name="ChatScroll" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="ChatList" Spacing="10" Margin="14,12,16,12" />
        </ScrollViewer>

        <Border Grid.Row="3" Padding="12,10,12,12" BorderBrush="{StaticResource Vein}" BorderThickness="0,1,0,0">
          <StackPanel Spacing="6">
            <TextBlock x:Name="AttachInfo" Foreground="{StaticResource Pollen}" FontSize="12" IsVisible="False" />
            <Border Background="{StaticResource Canopy}" CornerRadius="10" BorderBrush="{StaticResource Vein}" BorderThickness="1" Padding="4">
              <Grid RowDefinitions="Auto,Auto">
                <TextBox x:Name="InputBox" Classes="bare" AcceptsReturn="True" TextWrapping="Wrap"
                         Watermark="Ceritakan aplikasi yang Anda mau…" MinHeight="54" MaxHeight="160"
                         KeyDown="OnInputKeyDown" />
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="2,0,2,2">
                  <Button Classes="ghost" Click="OnAttach" ToolTip.Tip="Lampirkan gambar (mis. sketsa UI)" Padding="7,4">
                    <Path Classes="icon" Data="{StaticResource IconImage}" Width="15" Height="15" />
                  </Button>
                  <TextBlock Grid.Column="1" Text="Ctrl+Enter untuk kirim" Classes="faint" FontSize="11"
                             VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />
                  <Button Grid.Column="2" x:Name="SendButton" Classes="primary" Click="OnSend" Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <TextBlock x:Name="SendText" Text="Kirim" />
                      <Path Classes="icon solid" Data="{StaticResource IconSend}" Width="11" Height="11" />
                    </StackPanel>
                  </Button>
                </Grid>
              </Grid>
            </Border>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <!-- ================= Status bar ================= -->
    <Border Grid.Row="2" Background="{StaticResource Canopy}" BorderBrush="{StaticResource Vein}" BorderThickness="0,1,0,0" Height="26">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="12,0">
        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource Leaf}" VerticalAlignment="Center" />
          <TextBlock x:Name="StatusText" Text="Siap" Classes="muted" FontSize="11.5" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="2" x:Name="CaretText" Classes="faint code" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0" />
        <TextBlock Grid.Column="3" x:Name="LangText" Classes="faint" VerticalAlignment="Center" Margin="0,0,16,0" />
        <TextBlock Grid.Column="4" x:Name="ProviderStatus" Classes="faint" VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</Window>
