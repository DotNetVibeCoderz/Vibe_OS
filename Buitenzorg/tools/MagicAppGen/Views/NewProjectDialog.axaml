<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="using:MagicAppGen.Services"
        x:Class="MagicAppGen.Views.NewProjectDialog"
        Width="820" Height="560" MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Title="Proyek baru" Background="{StaticResource Canopy}">
  <Grid ColumnDefinitions="*,300">
    <!-- Catalog -->
    <DockPanel Grid.Column="0" Margin="20,18,12,18">
      <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
        <TextBlock Text="Proyek baru" FontSize="20" FontWeight="SemiBold" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Managed = C# biasa (GC, LINQ, Buitenzorg.UI). Native = C# tanpa GC, paling cepat. Skrip = Python/JS/TS untuk interpreter kernel." />
      </StackPanel>
      <Border DockPanel.Dock="Top" Background="{StaticResource Understory}" CornerRadius="8" Padding="3" HorizontalAlignment="Left" Margin="0,0,0,10">
        <StackPanel Orientation="Horizontal" Spacing="2">
          <RadioButton Classes="seg" GroupName="kind" Content="Semua" IsChecked="True" Tag="all" Click="OnFilter" />
          <RadioButton Classes="seg" GroupName="kind" Content="Managed" Tag="Managed" Click="OnFilter" />
          <RadioButton Classes="seg" GroupName="kind" Content="Native" Tag="Native" Click="OnFilter" />
          <RadioButton Classes="seg" GroupName="kind" Content="Skrip" Tag="Script" Click="OnFilter" />
        </StackPanel>
      </Border>
      <ListBox x:Name="TemplateList" SelectionChanged="OnSelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="svc:ProjectTemplate">
            <StackPanel Spacing="3">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" />
                <Border Classes="chip"><TextBlock Text="{Binding KindLabel}" /></Border>
                <Border Classes="chip quiet"><TextBlock Text="{Binding Language}" /></Border>
              </StackPanel>
              <TextBlock Text="{Binding Summary}" Classes="muted" TextWrapping="Wrap" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Form -->
    <Border Grid.Column="1" Background="{StaticResource Understory}" BorderBrush="{StaticResource Vein}" BorderThickness="1,0,0,0">
      <DockPanel Margin="18">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button Content="Batal" Click="OnCancel" IsCancel="True" />
          <Button x:Name="CreateButton" Classes="primary" Content="Buat proyek" Click="OnCreate" IsDefault="True" />
        </StackPanel>
        <StackPanel Spacing="8">
          <TextBlock Text="NAMA APLIKASI" Classes="eyebrow" />
          <TextBox x:Name="NameBox" Text="Catatan" TextChanged="OnNameChanged" />
          <Border Classes="card" Padding="10,8" Margin="0,4,0,8">
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="74,*">
                <TextBlock Text="di perangkat" Classes="faint" />
                <TextBlock Grid.Column="1" x:Name="TargetText" Classes="code" Foreground="{StaticResource Leaf}" TextTrimming="CharacterEllipsis" />
              </Grid>
              <Grid ColumnDefinitions="74,*">
                <TextBlock Text="jalankan" Classes="faint" />
                <TextBlock Grid.Column="1" x:Name="RunText" Classes="code" TextTrimming="CharacterEllipsis" />
              </Grid>
            </StackPanel>
          </Border>
          <TextBlock Text="FOLDER" Classes="eyebrow" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBox x:Name="FolderBox" Classes="code" FontSize="11.5" TextWrapping="Wrap" />
            <Button Grid.Column="1" Content="…" Click="OnBrowse" Margin="6,0,0,0" ToolTip.Tip="Pilih folder induk" />
          </Grid>
          <TextBlock x:Name="NoteText" Classes="faint" TextWrapping="Wrap" Margin="0,6,0,0" />
          <TextBlock x:Name="ErrorText" Classes="error" IsVisible="False" />
        </StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
