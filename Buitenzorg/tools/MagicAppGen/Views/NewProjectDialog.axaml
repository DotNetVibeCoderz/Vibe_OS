<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="using:MagicAppGen.Services"
        x:Class="MagicAppGen.Views.NewProjectDialog"
        Width="560" Height="440" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="New Project From Template" Background="#1E1F26">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Top" Spacing="8">
      <TextBlock Text="Pick a template" FontWeight="Bold" Foreground="#7CC0FF" />
      <Grid ColumnDefinitions="110,*">
        <TextBlock Grid.Column="0" Text="App name" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" x:Name="NameBox" Text="MyApp" />
      </Grid>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="0,12,0,0">
      <Button Content="Cancel" Click="OnCancel" />
      <Button Content="Create" Click="OnCreate" IsDefault="True" />
    </StackPanel>

    <ListBox x:Name="TemplateList" Margin="0,10,0,0" Background="#232430">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="svc:ProjectTemplate">
          <StackPanel Margin="4">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding Title}" FontWeight="Bold" Foreground="#E6E6E6" />
              <Border Background="#2A4D6E" CornerRadius="4" Padding="5,1">
                <TextBlock Text="{Binding Language}" FontSize="11" Foreground="#CFE6FF" />
              </Border>
            </StackPanel>
            <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#9AA0AA" TextWrapping="Wrap" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
