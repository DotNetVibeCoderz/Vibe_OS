<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MagicAppGen.Views.GoToLineDialog"
        Width="300" Height="150" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Ke baris" Background="{StaticResource Understory}">
  <StackPanel Margin="18" Spacing="10">
    <TextBlock Text="NOMOR BARIS" Classes="eyebrow" />
    <TextBox x:Name="LineInput" Watermark="mis. 42" Classes="code" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Batal" Click="OnCancel" IsCancel="True" />
      <Button Classes="primary" Content="Ke baris" Click="OnGo" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
