<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    MagicAppGen configuration. Every value here is editable from the UI
    (Settings dialog) and written back to this file. The active provider chooses
    which LLM the AI assistant "Jack - The Code Bender" talks to.
  -->
  <appSettings>
    <add key="ActiveProvider" value="OpenAI" />
    <add key="Language" value="C#" />
    <add key="Temperature" value="0.7" />
    <add key="ShowLineNumbers" value="true" />
    <add key="SystemPrompt" value="You are Jack - The Code Bender, an expert assistant that writes applications for Buitenzorg OS. Buitenzorg ring-3 apps are C# compiled with bflat --stdlib:zero (no full GC): keep heap state in locals not static reference fields, use function pointers not method-group delegates, use linked lists not object[] for reference collections, and build text with char[] + Graphics.DrawChars (no string concat). UI is built with the Buitenzorg.UI toolkit over Buitenzorg.Drawing; audio via Buitenzorg.Audio; and Buitenzorg.Bcl (bzbcl.cs + bzbcl2.cs) provides collections/LINQ plus System.IO, System.Text(+Regex), System.Globalization (incl. BzDateTime on the real clock), System.Diagnostics, System.Management, System.Net.Sockets (UDP, loopback only - there is no TCP), System.Threading.Tasks, System.Timers, GC and Pkg. Call GetApiReference before writing code so you use the exact signatures. Always produce complete, compilable code for both UI and backend, and explain briefly." />

    <!-- OpenAI -->
    <add key="OpenAI.Model" value="gpt-4o" />
    <add key="OpenAI.ApiKey" value="sk-proj-xxx" />
    <add key="OpenAI.Endpoint" value="https://api.openai.com/v1" />

    <!-- Claude (Anthropic) -->
    <add key="Claude.Model" value="claude-sonnet-4-5" />
    <add key="Claude.ApiKey" value="" />
    <add key="Claude.Endpoint" value="" />

    <!-- Gemini (Google AI) -->
    <add key="Gemini.Model" value="gemini-1.5-pro" />
    <add key="Gemini.ApiKey" value="" />
    <add key="Gemini.Endpoint" value="" />

    <!-- Ollama (local) -->
    <add key="Ollama.Model" value="llama3.1" />
    <add key="Ollama.ApiKey" value="" />
    <add key="Ollama.Endpoint" value="http://localhost:11434" />

    <!-- Tools -->
    <add key="Tavily.ApiKey" value="tvly-dev-xxx" />
    <!-- Buitenzorg repo root, so build/run functions can find scripts. -->
    <add key="Buitenzorg.Root" value="[PATH TO REPO FOLDER]" />
  </appSettings>
</configuration>
