<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    MagicAppGen configuration. Every value here is editable from the UI
    (Alat > Pengaturan) and written back to the deployed copy of this file.

    SECURITY: API keys are intentionally left BLANK here so no secret is ever
    committed to git. Set your keys in the Settings dialog - they are saved to
    the deployed bin/.../MagicAppGen.dll.config, which is gitignored. A fresh
    `dotnet build` copies this file over the deployed one, so re-enter keys
    after rebuilding, or export them as environment variables
    (ANTHROPIC_API_KEY, OPENAI_API_KEY, AZURE_OPENAI_API_KEY, ...) for
    the headless LLM test mode.
  -->
  <appSettings>
    <add key="ActiveProvider" value="Claude" />
    <add key="Language" value="C#" />
    <add key="Temperature" value="0.3" />
    <add key="ShowLineNumbers" value="true" />
    <!-- Empty = the built-in prompt (AiService.DefaultSystemPrompt), which knows
         the native, managed and script app kinds and the deploy tools. -->
    <add key="SystemPrompt" value="" />

    <!-- LLM providers (model lists reviewed 2026-11; any model id can be typed in Settings). -->
    <add key="OpenAI.Model" value="gpt-5.6-sol" />
    <add key="OpenAI.ApiKey" value="" />
    <add key="OpenAI.Endpoint" value="https://api.openai.com/v1" />

    <!-- Azure OpenAI: Model = deployment name, Endpoint = https://<resource>.openai.azure.com/ -->
    <add key="AzureOpenAI.Model" value="gpt-5.6-luna" />
    <add key="AzureOpenAI.ApiKey" value="" />
    <add key="AzureOpenAI.Endpoint" value="" />

    <add key="Claude.Model" value="claude-opus-5-5" />
    <add key="Claude.ApiKey" value="" />
    <add key="Claude.Endpoint" value="" />
    <!-- Only for API keys that are not scoped to a workspace (sent as anthropic-workspace-id). -->
    <add key="Claude.Workspace" value="" />

    <add key="Gemini.Model" value="gemini-3.5-flash" />
    <add key="Gemini.ApiKey" value="" />
    <add key="Gemini.Endpoint" value="" />

    <add key="DeepSeek.Model" value="deepseek-v4-flash" />
    <add key="DeepSeek.ApiKey" value="" />
    <add key="DeepSeek.Endpoint" value="https://api.deepseek.com" />

    <add key="Ollama.Model" value="qwen3" />
    <add key="Ollama.ApiKey" value="" />
    <add key="Ollama.Endpoint" value="http://localhost:11434" />

    <!-- Devices reachable over BZDP (UDP): "name|host|port|pairing code" separated by ';'. -->
    <add key="Device.Profiles" value="QEMU lokal|127.0.0.1|7070|0000;Raspberry Pi|192.168.1.50|7070|0000" />
    <add key="Device.Active" value="QEMU lokal" />
    <!-- Upload BZAPP.DLL / BZUI.DLL together with a managed app. -->
    <add key="Deploy.RuntimeLibraries" value="false" />
    <!-- Native C# target: x64 or arm64. -->
    <add key="Native.Arch" value="x64" />

    <!-- Tools -->
    <add key="Tavily.ApiKey" value="" />
    <!-- Buitenzorg repo root (bflat, libraries, scripts). Empty = found automatically
         by walking up from MagicAppGen's own folder. -->
    <add key="Buitenzorg.Root" value="" />
  </appSettings>
</configuration>
