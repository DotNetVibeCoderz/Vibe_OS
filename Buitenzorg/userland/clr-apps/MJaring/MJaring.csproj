<Project Sdk="Microsoft.NET.Sdk">
  <!-- Jaringan (network status + Wi-Fi): /disk/MJARING.DLL, `run mjaring`, opened by the
       tray's network icon. Its NetworkPanel is also Pengaturan's "Jaringan" page. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MJaring</AssemblyName>
    <RootNamespace>MJaring</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Buitenzorg.UI\Buitenzorg.UI.csproj" />
  </ItemGroup>
</Project>
