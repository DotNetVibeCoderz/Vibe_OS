<Project Sdk="Microsoft.NET.Sdk">
  <!-- Video (MJPEG + PCM AVI player, managed): /disk/MVIDEO.DLL, `run mvideo`. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MVideo</AssemblyName>
    <RootNamespace>MVideo</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Buitenzorg.UI\Buitenzorg.UI.csproj" />
  </ItemGroup>
</Project>
