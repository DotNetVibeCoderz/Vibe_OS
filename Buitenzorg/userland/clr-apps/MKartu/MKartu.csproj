<Project Sdk="Microsoft.NET.Sdk">
  <!-- Kartu (patience card game, managed): /disk/MKARTU.DLL, `run mkartu`. Buitenzorg.Game. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MKartu</AssemblyName>
    <RootNamespace>MKartu</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Buitenzorg.Game\Buitenzorg.Game.csproj" />
  </ItemGroup>
</Project>
