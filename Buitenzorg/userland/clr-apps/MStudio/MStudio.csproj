<Project Sdk="Microsoft.NET.Sdk">
  <!-- Buitenzorg Studio (IDE): /disk/MSTUDIO.DLL, `run mstudio`. Buitenzorg.UI app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MStudio</AssemblyName>
    <RootNamespace>MStudio</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Buitenzorg.UI\Buitenzorg.UI.csproj" />
  </ItemGroup>
</Project>
