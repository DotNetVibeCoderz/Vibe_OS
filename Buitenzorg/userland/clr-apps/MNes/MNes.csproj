<Project Sdk="Microsoft.NET.Sdk">
  <!-- NES emulator (managed UI over the clrhost core nes.rs): /disk/MNES.DLL, `run mnes`. Buitenzorg.Game. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MNes</AssemblyName>
    <RootNamespace>MNes</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Buitenzorg.Game\Buitenzorg.Game.csproj" />
  </ItemGroup>
</Project>
