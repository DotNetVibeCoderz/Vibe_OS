<Project Sdk="Microsoft.NET.Sdk">
  <!-- Labirin Kebun (first-person maze, managed): /disk/MLABIRIN.DLL, `run mlabirin`. Ray-cast by the host (RayRender). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MLabirin</AssemblyName>
    <RootNamespace>MLabirin</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Buitenzorg.Game\Buitenzorg.Game.csproj" />
  </ItemGroup>
</Project>
