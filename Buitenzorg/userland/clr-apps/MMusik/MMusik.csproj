<Project Sdk="Microsoft.NET.Sdk">
  <!-- Musik (music player, managed): /disk/MMUSIK.DLL, `run mmusik`. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MMusik</AssemblyName>
    <RootNamespace>MMusik</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Buitenzorg.UI\Buitenzorg.UI.csproj" />
  </ItemGroup>
</Project>
