<Project Sdk="Microsoft.NET.Sdk">
  <!-- Tanggal & Waktu (date, time, region): /disk/MWAKTU.DLL, `run mwaktu`, opened by the tray clock. Buitenzorg.UI app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MWaktu</AssemblyName>
    <RootNamespace>MWaktu</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Buitenzorg.UI\Buitenzorg.UI.csproj" />
  </ItemGroup>
</Project>
