<Project Sdk="Microsoft.NET.Sdk">
  <!-- Konsol (standalone terminal): /disk/MKONSOL.DLL, `run mkonsol`. Buitenzorg.UI app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MKonsol</AssemblyName>
    <RootNamespace>MKonsol</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Buitenzorg.UI\Buitenzorg.UI.csproj" />
  </ItemGroup>
</Project>
