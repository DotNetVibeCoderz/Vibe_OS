<Project Sdk="Microsoft.NET.Sdk">
  <!-- Aplikasi Managed: the folder of managed (RustCLR) apps, opened from the
       desktop icon. /disk/MANAGED.DLL, `run managed`. Its self-test runs every
       app's self-test in one process (the boot check). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Managed</AssemblyName>
    <RootNamespace>Managed</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Buitenzorg.UI\Buitenzorg.UI.csproj" />
    <ProjectReference Include="..\MCalc\MCalc.csproj" />
