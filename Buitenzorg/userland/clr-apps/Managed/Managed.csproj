    <ProjectReference Include="..\MClock\MClock.csproj" />
    <ProjectReference Include="..\MGallery\MGallery.csproj" />
    <ProjectReference Include="..\MHwLab\MHwLab.csproj" />
    <ProjectReference Include="..\MSetting\MSetting.csproj" />
    <ProjectReference Include="..\MWaktu\MWaktu.csproj" />
    <ProjectReference Include="..\MImage\MImage.csproj" />
    <ProjectReference Include="..\MPaint\MPaint.csproj" />
    <ProjectReference Include="..\MPiano\MPiano.csproj" />
    <ProjectReference Include="..\MRuang\MRuang.csproj" />
  </ItemGroup>
