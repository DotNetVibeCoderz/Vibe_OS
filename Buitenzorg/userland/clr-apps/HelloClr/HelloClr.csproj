<Project Sdk="Microsoft.NET.Sdk">
  <!-- A managed C# app for Buitenzorg's RustCLR path: a plain `dotnet build`
       of an ordinary console program, run unmodified by CLRHOST.ELF. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HelloClr</AssemblyName>
    <RootNamespace>HelloClr</RootNamespace>
  </PropertyGroup>
</Project>
