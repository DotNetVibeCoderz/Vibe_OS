<Project Sdk="Microsoft.NET.Sdk">
  <!-- Bata (brick-breaking game, managed): /disk/MBATA.DLL, `run mbata`. Buitenzorg.Game. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MBata</AssemblyName>
    <RootNamespace>MBata</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Buitenzorg.Game\Buitenzorg.Game.csproj" />
  </ItemGroup>
</Project>
