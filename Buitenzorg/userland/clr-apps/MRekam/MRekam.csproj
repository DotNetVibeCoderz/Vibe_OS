<Project Sdk="Microsoft.NET.Sdk">
  <!-- Perekam Suara (sound recorder): /disk/MREKAM.DLL, `run mrekam`. Buitenzorg.UI app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MRekam</AssemblyName>
    <RootNamespace>MRekam</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Buitenzorg.UI\Buitenzorg.UI.csproj" />
  </ItemGroup>
</Project>
