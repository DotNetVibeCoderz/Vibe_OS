<Project Sdk="Microsoft.NET.Sdk">
  <!-- Balok (falling blocks game, managed): /disk/MBALOK.DLL, `run mbalok`. Buitenzorg.Game. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MBalok</AssemblyName>
    <RootNamespace>MBalok</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Buitenzorg.Game\Buitenzorg.Game.csproj" />
  </ItemGroup>
</Project>
