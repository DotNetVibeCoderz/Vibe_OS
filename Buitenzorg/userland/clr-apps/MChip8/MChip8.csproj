<Project Sdk="Microsoft.NET.Sdk">
  <!-- CHIP-8 emulator (managed): /disk/MCHIP8.DLL, `run mchip8`. Buitenzorg.Game. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MChip8</AssemblyName>
    <RootNamespace>MChip8</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Buitenzorg.Game\Buitenzorg.Game.csproj" />
  </ItemGroup>
</Project>
