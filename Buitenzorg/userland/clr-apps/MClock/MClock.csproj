<Project Sdk="Microsoft.NET.Sdk">
  <!-- Jam (managed clock / stopwatch / timer / calendar): /disk/MCLOCK.DLL, `run mclock`. Buitenzorg.UI app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MClock</AssemblyName>
    <RootNamespace>MClock</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Buitenzorg.UI\Buitenzorg.UI.csproj" />
  </ItemGroup>
</Project>
