<Project Sdk="Microsoft.NET.Sdk">
  <!-- A managed GUI app for Buitenzorg (RustCLR): a window with an analog
       clock, drawn through Buitenzorg.App. /disk/HELLOGUI.DLL; run it with
       `run hellogui` (shell) or from the Start menu. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>HelloGui</AssemblyName>
    <RootNamespace>HelloGui</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Buitenzorg.App\Buitenzorg.App.csproj" />
  </ItemGroup>
</Project>
