<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pengaturan (desktop settings): /disk/MSETTING.DLL, `run msetting`. Buitenzorg.UI app. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MSetting</AssemblyName>
    <RootNamespace>MSettings</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Buitenzorg.UI\Buitenzorg.UI.csproj" />
  </ItemGroup>
</Project>
